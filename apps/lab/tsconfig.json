{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./src/*"],
			"@phonaria/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"scripts/**/*.ts",
		"drizzle.config.ts",
		"vite.config.mts",
		"worker-configuration.d.ts"
	],
	"exclude": ["node_modules", "dist", ".output"]
}
