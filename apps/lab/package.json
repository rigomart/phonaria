{
	"name": "@phonaria/lab",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.3.2",
	"scripts": {
		"dev": "bun --bun next dev",
		"dev:next": "bun --bun next dev",
		"dev:start": "vite dev",
		"build": "bun --bun next build",
		"build:next": "bun --bun next build",
		"build:start": "bun ./scripts/write-start-dev-vars.ts && vite build",
		"start": "bun --bun next start",
		"preview:start": "vite preview",
		"deploy:start": "bun ./scripts/write-start-dev-vars.ts && vite build && wrangler deploy",
		"deploy:start:staging": "bun ./scripts/write-start-dev-vars.ts && vite build && wrangler deploy --env staging",
		"cf-typegen": "wrangler types",
		"worker-metrics": "bun ./scripts/record-worker-metrics.ts",
		"lint": "biome check --write",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.start.json",
		"test": "vitest run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@fontsource-variable/sora": "^5.3.0",
		"@libsql/client": "^0.15.0",
		"@phonaria/flags": "workspace:*",
		"@phonaria/phonetics-data": "workspace:*",
		"@phonaria/ui": "workspace:*",
		"@tanstack/react-router": "1.170.36",
		"@tanstack/react-start": "1.168.53",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.1",
		"lucide-react": "^0.555.0",
		"next": "^16.0.10",
		"next-themes": "^0.4.6",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"tailwind-merge": "^3.3.1",
		"zod": "^4.1.5",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.54.8",
		"@next/env": "^16.1.1",
		"@tailwindcss/postcss": "^4.1.12",
		"@types/node": "^20",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"drizzle-kit": "^0.31.8",
		"typescript": "^5",
		"vite": "8.3.0",
		"vitest": "^3.2.4",
		"wrangler": "4.131.1"
	}
}
