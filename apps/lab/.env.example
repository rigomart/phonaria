TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-auth-token"
NEXT_PUBLIC_BUCKET_URL="bucket_url"
PUBLIC_BUCKET_URL="bucket_url"

# Absolute origin serving the app, no trailing slash. Required for production
# builds; canonical, OpenGraph, robots, and sitemap URLs are built from it.
SITE_URL="https://phonaria.rigos.dev"
# Allow search engines to index the site. Off unless set to 1 or true.
SITE_INDEXING_ENABLED="0"
# Optional Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=""

# TanStack Start / Cloudflare (no VITE_ secrets). Wrangler vars override these
# at request time. `bun --cwd apps/lab dev:start` listens on port 3001 so it
# can run beside `bun dev` (Next.js on 3000).
# FLAG_PRACTICE="1"

# For local Start, copy TURSO_DATABASE_URL and TURSO_AUTH_TOKEN into `.dev.vars`
# by hand. `bun --cwd apps/lab build:start` preserves those lines and never
# copies Turso values from this file into the prerender Worker.
