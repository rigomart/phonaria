{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./src/*"],
			"@phonaria/ui/*": ["../../packages/ui/src/*"]
		}
	},
	"include": [
		"src/router.tsx",
		"src/start.ts",
		"src/routeTree.gen.ts",
		"src/routes/**/*.ts",
		"src/routes/**/*.tsx",
		"src/platform/**/*.ts",
		"src/platform/**/*.tsx",
		"src/components/**/*.ts",
		"src/components/**/*.tsx",
		"src/hooks/**/*.ts",
		"src/hooks/**/*.tsx",
		"src/lib/**/*.ts",
		"src/lib/**/*.tsx",
		"src/db/**/*.ts",
		"src/server/**/*.ts",
		"src/server/**/*.d.ts",
		"vite.config.mts"
	],
	"exclude": ["src/platform/next/**", "src/app/**", "node_modules", "**/*.test.ts"]
}
