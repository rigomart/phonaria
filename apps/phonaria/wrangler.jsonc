{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "phonaria",
	"compatibility_date": "2026-09-12",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"assets": {
		"html_handling": "drop-trailing-slash",
		"run_worker_first": [
			"/",
			"/credits",
			"/credits/",
			"/ipa-chart",
			"/ipa-chart/*",
			"/practice",
			"/practice/*",
			"/language-spread",
			"/robots.txt",
			"/sitemap.xml",
			"/en",
			"/en/*",
			"/es",
			"/es/*"
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"ratelimits": [
		{
			"name": "TRANSCRIPTION_RATE_LIMIT",
			"namespace_id": "175001",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "DEFINITION_RATE_LIMIT",
			"namespace_id": "175101",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "SPELLING_CONTEXT_RATE_LIMIT",
			"namespace_id": "175201",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "SPEECH_RATE_LIMIT",
			"namespace_id": "175301",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	"vars": {
		"SITE_INDEXING_ENABLED": "0",
		"SITE_URL": "http://localhost:3000"
	},
	// Named environments flatten at `vite build` via CLOUDFLARE_ENV.
	// `wrangler deploy --env` is ignored once Vite writes dist/server/wrangler.json.
	"env": {
		"staging": {
			"name": "phonaria-staging",
			"ratelimits": [
				{
					"name": "TRANSCRIPTION_RATE_LIMIT",
					"namespace_id": "175002",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "DEFINITION_RATE_LIMIT",
					"namespace_id": "175102",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "SPELLING_CONTEXT_RATE_LIMIT",
					"namespace_id": "175202",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "SPEECH_RATE_LIMIT",
					"namespace_id": "175302",
					"simple": { "limit": 20, "period": 60 }
				}
			],
			"vars": {
				"SITE_URL": "https://phonaria-staging.workers.dev",
				"SITE_INDEXING_ENABLED": "0",
				"FLAG_PRACTICE": "1",
				"FLAG_LANGUAGE_SPREAD": "1",
				"FLAG_SPEECH": "1"
			}
		},
		"preview": {
			"name": "phonaria-preview",
			"ratelimits": [
				{
					"name": "TRANSCRIPTION_RATE_LIMIT",
					"namespace_id": "175003",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "DEFINITION_RATE_LIMIT",
					"namespace_id": "175103",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "SPELLING_CONTEXT_RATE_LIMIT",
					"namespace_id": "175203",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "SPEECH_RATE_LIMIT",
					"namespace_id": "175303",
					"simple": { "limit": 20, "period": 60 }
				}
			],
			"vars": {
				"SITE_URL": "https://phonaria-preview.workers.dev",
				"SITE_INDEXING_ENABLED": "0",
				"FLAG_PRACTICE": "1",
				"FLAG_LANGUAGE_SPREAD": "1",
				"FLAG_SPEECH": "1"
			}
		},
		"production": {
			"name": "phonaria",
			"routes": [
				{ "pattern": "phonaria.rigos.dev", "custom_domain": true },
				{ "pattern": "phonaria-lab.rigos.dev", "custom_domain": true }
			],
			"ratelimits": [
				{
					"name": "TRANSCRIPTION_RATE_LIMIT",
					"namespace_id": "175004",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "DEFINITION_RATE_LIMIT",
					"namespace_id": "175104",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "SPELLING_CONTEXT_RATE_LIMIT",
					"namespace_id": "175204",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "SPEECH_RATE_LIMIT",
					"namespace_id": "175304",
					"simple": { "limit": 20, "period": 60 }
				}
			],
			"vars": {
				"SITE_URL": "https://phonaria.rigos.dev",
				"SITE_INDEXING_ENABLED": "1",
				"FLAG_PRACTICE": "0",
				"FLAG_LANGUAGE_SPREAD": "0",
				"FLAG_SPEECH": "0"
			}
		}
	}
}
