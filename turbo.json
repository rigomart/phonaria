{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"],
			"env": [
				"FLAG_*",
				"UPSTASH_REDIS_REST_URL",
				"UPSTASH_REDIS_REST_TOKEN",
				"CMUDICT_SRC_URL",
				"DATABASE_URL",
				"GOOGLE_SITE_VERIFICATION",
				"NEXT_PUBLIC_BUCKET_URL",
				"PUBLIC_BUCKET_URL",
				"SITE_URL",
				"SITE_INDEXING_ENABLED",
				"TURSO_DATABASE_URL",
				"TURSO_AUTH_TOKEN"
			],
			"inputs": ["$TURBO_DEFAULT$", ".env*"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"e2e": {
			"dependsOn": ["build"],
			"cache": false,
			"env": ["SKIP_RATE_LIMIT", "DATABASE_URL"]
		},
		"e2e:lab": {
			"cache": false,
			"env": [
				"LAB_CONTRACT_TARGET",
				"LAB_CONTRACT_BASE_URL",
				"LAB_CONTRACT_CANONICAL_ORIGIN",
				"LAB_CONTRACT_START_LOCAL",
				"LAB_CONTRACT_WRITE_BASELINE",
				"CF_ACCESS_CLIENT_ID",
				"CF_ACCESS_CLIENT_SECRET"
			]
		}
	}
}
