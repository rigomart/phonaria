{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".output/**"],
			"env": [
				"FLAG_*",
				"GOOGLE_SITE_VERIFICATION",
				"PUBLIC_BUCKET_URL",
				"SITE_URL",
				"SITE_INDEXING_ENABLED",
				"TURSO_DATABASE_URL",
				"TURSO_AUTH_TOKEN"
			],
			"inputs": ["$TURBO_DEFAULT$", ".env*"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"e2e": {
			"cache": false,
			"env": [
				"CONTRACT_TARGET",
				"CONTRACT_BASE_URL",
				"CONTRACT_CANONICAL_ORIGIN",
				"CONTRACT_START_LOCAL",
				"CONTRACT_WRITE_BASELINE",
				"CF_ACCESS_CLIENT_ID",
				"CF_ACCESS_CLIENT_SECRET"
			]
		}
	}
}
