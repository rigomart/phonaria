# Required: key and matching region from an Azure Speech resource
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Catalog defaults live in catalog-config.json (Jenny, 10% slower, Ogg/Opus).
# Optional overrides:
# AZURE_SPEECH_VOICE=en-US-JennyNeural
# AZURE_SPEECH_RATE_PERCENT=-10
# AZURE_SPEECH_FORMAT=ogg
# Default pacing also fits the free Speech tier
AZURE_REQUESTS_PER_MINUTE=20
