{
	"name": "@phonaria/audio-gen",
	"version": "1.0.0",
	"description": "Local Azure Speech pronunciation audio generation for Phonaria",
	"keywords": [
		"phonaria",
		"audio-gen",
		"tts",
		"audio-generation",
		"azure-speech"
	],
	"author": "Miguel Rodriguez",
	"packageManager": "bun@1.3.2",
	"scripts": {
		"lint": "biome check --write",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"generate": "bun src/generate.ts",
		"probe": "bun src/probe.ts"
	},
	"dependencies": {
		"dotenv": "^17.2.0",
		"@phonaria/phonetics-data": "workspace:*"
	},
	"devDependencies": {
		"vitest": "^3.2.4",
		"typescript": "~5.8.3",
		"@types/node": "^24.0.10"
	}
}
