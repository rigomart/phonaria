{
	"name": "@phonaria/ui",
	"version": "0.1.0",
	"private": true,
	"description": "Shared UI components for Phonaria (source-imported, no build step).",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"sideEffects": false,
	"packageManager": "bun@1.3.2",
	"exports": {
		"./index.css": "./src/index.css",
		"./postcss.config": "./postcss.config.mjs",
		"./lib/*": "./src/lib/*.ts",
		"./components/*": "./src/components/*.tsx",
		"./hooks/*": "./src/hooks/*.ts"
	},
	"scripts": {
		"lint": "biome check --write",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.0.0",
		"@hugeicons/core-free-icons": "^2.0.0",
		"@hugeicons/react": "^1.1.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.1.18",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"tailwindcss": "^4.1.18"
	}
}
