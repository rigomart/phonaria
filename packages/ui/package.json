{
	"name": "@phonaria/ui",
	"version": "0.1.0",
	"private": true,
	"description": "Shared UI components for Phonaria (source-imported, no build step).",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"sideEffects": false,
	"packageManager": "bun@1.3.2",
	"exports": {
		".": "./src/index.ts",
		"./lib/*": "./src/lib/*.ts",
		"./components/ui/*": "./src/components/ui/*.tsx"
	},
	"scripts": {
		"lint": "biome check --write",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.2.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.3.1"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19"
	}
}
