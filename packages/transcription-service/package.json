{
	"name": "@phonaria/transcription-service",
	"version": "0.1.0",
	"description": "Framework-neutral transcription service for Phonaria",
	"sideEffects": false,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./contract": "./src/contract.ts",
		"./server": {
			"node": "./src/server.ts",
			"default": "./src/server.ts"
		}
	},
	"packageManager": "bun@1.3.2",
	"scripts": {
		"lint": "biome check --write",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@phonaria/phonetics-data": "workspace:*",
		"zod": "^3.24.1",
		"@libsql/client": "^0.17.0",
		"drizzle-orm": "^0.39.2"
	},
	"devDependencies": {
		"@types/node": "^26.5.1",
		"vitest": "^3.2.4"
	}
}
