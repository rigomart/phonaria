{
	"name": "@phonaria/helper-scripts",
	"version": "1.0.0",
	"description": "Collection of helper scripts for Phonaria application including TTS audio generation and data processing utilities",
	"keywords": [
		"phonaria",
		"helper-scripts",
		"tts",
		"data-processing"
	],
	"author": "",
	"license": "ISC",
	"packageManager": "bun@1.3.2",
	"scripts": {
		"lint": "biome check --write",
		"check-types": "tsc --noEmit",
		"cmudict-to-json": "tsx src/cmudict-to-json.ts",
		"cmudict-stats": "tsx src/cmudict-stats.ts",
		"generate-word-mappings": "tsx src/generate-word-mappings.ts",
		"phoneme-trie-to-json": "tsx src/phoneme-trie-to-json.ts",
		"migrate-diagrams": "tsx src/migrate-diagrams.ts",
		"migrate-diagrams-to-accent": "tsx src/migrate-diagrams-to-accent.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.985.0",
		"@phonaria/phonetics-data": "workspace:*",
		"@types/node": "^24.0.10",
		"dotenv": "^17.2.0"
	},
	"devDependencies": {
		"tsx": "^4.20.3",
		"typescript": "~5.8.3"
	}
}
